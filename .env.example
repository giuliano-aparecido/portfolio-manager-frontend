# Base URL of the portfolio-manager-backend FastAPI service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Shared HMAC secret with the backend's PyJWT verification — must be the
# exact same value configured there (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=

# NextAuth URL (optional, defaults to http://localhost:3000 in dev)
NEXTAUTH_URL=

# Google OAuth (get from Google Cloud Console) — not needed in dev, which
# uses a fixed auto-signin dev user instead
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
